{
  "name": "inbound-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,admin -c blue,green \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@next/env": "^16.2.6",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10"
  }
}
